@page "{id:int}"
@model CIDM_3312_Final_Project.Pages.Platforms.DeleteModel
@{
    ViewData["Title"] = "Delete Platform";
}

<h1>Delete Platform</h1>

<h3>Are you sure you want to delete this platform?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Platform.Name)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Platform.Name)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Platform.Company)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Platform.Company)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Platform.ConsoleType)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Platform.ConsoleType)</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Platform.PlatformId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
