@page
@model CIDM_3312_Final_Project.Pages.Platforms.CreateModel
@{
    ViewData["Title"] = "Add New Platform";
}

<h1>Add New Platform</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Platform.Name" class="control-label"></label>
                <input asp-for="Platform.Name" class="form-control" />
                <span asp-validation-for="Platform.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Platform.Company" class="control-label"></label>
                <input asp-for="Platform.Company" class="form-control" />
                <span asp-validation-for="Platform.Company" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Platform.ConsoleType" class="control-label"></label>
                <input asp-for="Platform.ConsoleType" class="form-control" />
                <span asp-validation-for="Platform.ConsoleType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
