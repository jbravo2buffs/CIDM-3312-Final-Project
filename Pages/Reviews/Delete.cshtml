@page "{id:int}"
@model CIDM_3312_Final_Project.Pages.Reviews.DeleteModel
@{
    ViewData["Title"] = "Delete Review";
}

<h1>Delete Review</h1>

<h3>Are you sure you want to delete this review?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Review.Game)</dt>
        <dd class="col-sm-9">@Model.Review.Game?.Title</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Review.ReviewerName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Review.ReviewerName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Review.Score)</dt>
        <dd class="col-sm-9">@Model.Review.Score/10</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Review.Comment)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Review.Comment)</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Review.ReviewId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
